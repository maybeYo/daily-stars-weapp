{
  "pages": [
    "pages/index/index",
    "pages/stats/stats",
    "pages/edit/edit"
  ],
  "window": {
    "navigationBarTitleText": "Daily Stars",
    "navigationBarBackgroundColor": "@navBg",
    "navigationBarTextStyle": "@navText",
    "backgroundColor": "@bg",
    "backgroundTextStyle": "@bgText"
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelected",
    "backgroundColor": "@tabBg",
    "borderStyle": "@tabBorder",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "今日打卡",
        "iconPath": "images/tabbar/today.png",
        "selectedIconPath": "images/tabbar/today-active.png"
      },
      {
        "pagePath": "pages/stats/stats",
        "text": "统计",
        "iconPath": "images/tabbar/stats.png",
        "selectedIconPath": "images/tabbar/stats-active.png"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "darkmode": true,
  "themeLocation": "theme.json"
}
