<view class="page">
  <view class="label">习惯名称</view>
  <input
    class="input"
    value="{{name}}"
    placeholder="例如：早起、阅读 30 分钟"
    maxlength="20"
    bindinput="onInput"
  />

  <view class="label">选择图标</view>
  <view class="icons">
    <view
      wx:for="{{icons}}"
      wx:key="*this"
      class="icon-item {{item === icon ? 'active' : ''}}"
      data-icon="{{item}}"
      bindtap="onPick"
    >{{item}}</view>
  </view>

  <view class="save btn btn-primary" bindtap="onSave">保存</view>
  <view wx:if="{{id}}" class="delete" bindtap="onDelete">删除这个习惯</view>
</view>
