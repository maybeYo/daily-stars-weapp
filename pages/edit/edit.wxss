.label {
  margin: 32rpx 0 16rpx;
  font-size: 26rpx;
  color: #9A8F7E;
}

.label:first-child {
  margin-top: 0;
}

.input {
  height: 96rpx;
  padding: 0 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  font-size: 30rpx;
}

.icons {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.icon-item {
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  text-align: center;
  font-size: 52rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.icon-item.active {
  border-color: #F5B301;
  background: #FFF3CC;
}

.save {
  margin-top: 64rpx;
}

.delete {
  margin-top: 32rpx;
  text-align: center;
  color: #E5533D;
  font-size: 28rpx;
}
