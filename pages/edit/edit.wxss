.label {
  margin: 32rpx 0 16rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.label:first-child {
  margin-top: 0;
}

.input {
  height: 96rpx;
  padding: 0 28rpx;
  background: var(--surface);
  border-radius: 20rpx;
  font-size: 30rpx;
}

.types {
  display: flex;
  gap: 20rpx;
}

.type {
  flex: 1;
  padding: 24rpx;
  background: var(--surface);
  border: 4rpx solid transparent;
  border-radius: 20rpx;
}

.type.active {
  border-color: var(--accent);
  background: var(--checked-bg);
}

.type-name {
  font-size: 30rpx;
  font-weight: 600;
}

.type.active .type-name {
  color: var(--checked-text);
}

.type-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: var(--faint);
}

.icons {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.icon-item {
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  text-align: center;
  font-size: 52rpx;
  background: var(--surface);
  border-radius: 20rpx;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.icon-item.active {
  border-color: var(--accent);
  background: var(--checked-bg);
}

.save {
  margin-top: 64rpx;
}

.delete {
  margin-top: 32rpx;
  text-align: center;
  color: var(--danger);
  font-size: 28rpx;
}
