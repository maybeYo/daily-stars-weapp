/* 棋盘 660rpx：15 × 15 格，每格 44 */
/* 撑满一屏，下面空出来的地方都给摇杆 */
.snake {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 32rpx;
  box-sizing: border-box;
  --board: #EFE6D2;
  --body: #8BC34A;
  --head: #558B2F;
  --dead: #E5533D;
}

@media (prefers-color-scheme: dark) {
  .snake {
    --board: #2A241C;
    --body: #7CB342;
    --head: #AED581;
    --dead: #FF6B57;
  }
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 60rpx;
  font-weight: 800;
}

.scores {
  display: flex;
  gap: 12rpx;
}

.score-box {
  min-width: 128rpx;
  padding: 10rpx 20rpx;
  text-align: center;
  background: var(--surface);
  border-radius: 12rpx;
}

.score-label {
  font-size: 22rpx;
  color: var(--muted);
}

.score-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent-strong);
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0;
}

.hint {
  font-size: 24rpx;
  color: var(--muted);
}

.action {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--accent);
  border-radius: 12rpx;
}

.action:active {
  background: var(--accent-strong);
}

.board-wrap {
  position: relative;
  width: 660rpx;
  height: 660rpx;
  margin: 0 auto;
}

.board {
  position: relative;
  width: 100%;
  height: 100%;
  background: var(--board);
  border-radius: 16rpx;
  overflow: hidden;
}

.seg,
.food {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
}

.seg::after {
  content: '';
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  bottom: 2rpx;
  left: 2rpx;
  background: var(--body);
  border-radius: 8rpx;
}

.head-seg::after {
  background: var(--head);
  border-radius: 12rpx;
}

.dead::after {
  background: var(--dead);
}

.food {
  line-height: 44rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--accent);
  animation: twinkle 1s ease-in-out infinite;
}

@keyframes twinkle {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(0.8); }
}

.overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 248, 231, 0.82);
  border-radius: 16rpx;
  animation: fade 0.3s ease;
}

@media (prefers-color-scheme: dark) {
  .overlay {
    background: rgba(23, 20, 15, 0.82);
  }
}

@keyframes fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.overlay-title {
  font-size: 44rpx;
  font-weight: 700;
}

.overlay-sub {
  margin: 12rpx 0 32rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.overlay-btn {
  width: 240rpx;
}

.zone {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.zone-hint {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
  font-size: 24rpx;
  color: var(--faint);
}

/* 摇杆用 px，和触摸坐标一致 */
.joy {
  position: fixed;
  width: 100px;
  height: 100px;
  margin: -50px 0 0 -50px;
  border-radius: 50%;
  background: rgba(245, 179, 1, 0.12);
  border: 2px solid rgba(245, 179, 1, 0.35);
  box-sizing: border-box;
  pointer-events: none;
  z-index: 10;
}

.knob {
  position: absolute;
  left: 26px;
  top: 26px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(245, 179, 1, 0.5);
}
