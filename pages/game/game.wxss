/* 棋盘 680rpx：4 格 × 150 + 5 道缝 × 16 */
.game {
  --board: #BBADA0;
  --slot: rgba(238, 228, 218, 0.35);
  --tile-dark: #776E65;
}

@media (prefers-color-scheme: dark) {
  .game {
    --board: #3A3229;
    --slot: rgba(255, 255, 255, 0.06);
  }
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 88rpx;
  font-weight: 800;
  color: var(--tile-dark);
}

@media (prefers-color-scheme: dark) {
  .title {
    color: var(--text);
  }
}

.scores {
  display: flex;
  gap: 12rpx;
}

.score-box {
  position: relative;
  min-width: 128rpx;
  padding: 10rpx 20rpx;
  text-align: center;
  background: var(--board);
  border-radius: 12rpx;
}

.score-label {
  font-size: 22rpx;
  color: #EEE4DA;
}

.score-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.gain {
  position: absolute;
  left: 0;
  right: 0;
  top: 40rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent-strong);
  opacity: 0;
  animation: gain 0.6s ease-out;
}

@keyframes gain {
  from { opacity: 1; transform: translateY(0); }
  to { opacity: 0; transform: translateY(-60rpx); }
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0 28rpx;
}

.hint {
  font-size: 24rpx;
  color: var(--muted);
}

.restart {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--accent);
  border-radius: 12rpx;
}

.restart:active {
  background: var(--accent-strong);
}

.board-wrap {
  position: relative;
  width: 680rpx;
  height: 680rpx;
  margin: 0 auto;
}

.board {
  position: relative;
  width: 100%;
  height: 100%;
  background: var(--board);
  border-radius: 16rpx;
}

.slot,
.tile {
  position: absolute;
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
}

.slot {
  background: var(--slot);
}

.tile {
  transition: left 0.1s ease-in-out, top 0.1s ease-in-out;
}

.tile-inner {
  width: 100%;
  height: 100%;
  line-height: 150rpx;
  text-align: center;
  font-size: 64rpx;
  font-weight: 700;
  border-radius: 10rpx;
  color: #F9F6F2;
}

.d3 .tile-inner { font-size: 52rpx; }
.d4 .tile-inner { font-size: 40rpx; }

.new .tile-inner { animation: appear 0.2s ease 0.1s both; }
.merged .tile-inner { animation: pop 0.2s ease 0.1s; }

@keyframes appear {
  from { opacity: 0; transform: scale(0); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.v2 .tile-inner { background: #EEE4DA; color: #776E65; }
.v4 .tile-inner { background: #EDE0C8; color: #776E65; }
.v8 .tile-inner { background: #F2B179; }
.v16 .tile-inner { background: #F59563; }
.v32 .tile-inner { background: #F67C5F; }
.v64 .tile-inner { background: #F65E3B; }
.v128 .tile-inner { background: #EDCF72; }
.v256 .tile-inner { background: #EDCC61; }
.v512 .tile-inner { background: #EDC850; }
.v1024 .tile-inner { background: #EDC53F; }
.v2048 .tile-inner { background: #EDC22E; box-shadow: 0 0 30rpx rgba(243, 215, 116, 0.6); }
.vsuper .tile-inner { background: #3C3A32; }

.overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(238, 228, 218, 0.8);
  border-radius: 16rpx;
  animation: fade 0.4s ease;
}

.overlay.win {
  background: rgba(237, 194, 46, 0.6);
}

@media (prefers-color-scheme: dark) {
  .overlay {
    background: rgba(23, 20, 15, 0.82);
  }
}

@keyframes fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.overlay-title {
  font-size: 48rpx;
  font-weight: 700;
}

.overlay-sub {
  margin: 12rpx 0 36rpx;
  font-size: 28rpx;
  color: var(--muted);
}

.overlay-btns {
  display: flex;
  gap: 20rpx;
}

.overlay-btn {
  width: 220rpx;
}

.foot {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
}
