<view class="page">
  <view class="overview">
    <view class="ov-item">
      <view class="ov-num">{{totalStars}}</view>
      <view class="ov-label">累计星星</view>
    </view>
    <view class="ov-item">
      <view class="ov-num">{{activeDays}}</view>
      <view class="ov-label">打卡天数</view>
    </view>
    <view class="ov-item">
      <view class="ov-num">{{bestStreak}}</view>
      <view class="ov-label">最长连续</view>
    </view>
  </view>

  <view class="section">
    <view class="cal-head">
      <view
        class="cal-nav {{canPrev ? '' : 'disabled'}}"
        aria-role="button"
        aria-label="上个月"
        bindtap="onPrevMonth"
      >‹</view>
      <view class="cal-center">
        <picker mode="date" fields="month" value="{{monthValue}}" bindchange="onPickMonth">
          <view class="cal-title" aria-role="button" aria-label="{{monthTitle}}，点击选择年月">
            {{monthTitle}}<text class="cal-title-arrow">▾</text>
          </view>
        </picker>
        <view
          wx:if="{{!isThisMonth}}"
          class="cal-today"
          aria-role="button"
          bindtap="onBackToday"
        >回到今天</view>
      </view>
      <view
        class="cal-nav {{canNext ? '' : 'disabled'}}"
        aria-role="button"
        aria-label="下个月"
        bindtap="onNextMonth"
      >›</view>
    </view>
    <view class="cal-summary">
      本月打卡 <text class="hl">{{monthDays}}</text> 天 · 全勤 <text class="hl">{{monthPerfect}}</text> 天
    </view>
    <view class="week-head">
      <view wx:for="{{weekNames}}" wx:key="*this" class="week-name">{{item}}</view>
    </view>
    <view class="grid">
      <view
        wx:for="{{cells}}"
        wx:key="key"
        class="cell {{item.isToday ? 'today' : ''}} {{item.isFuture ? 'future' : ''}} {{item.key === selectedKey ? 'selected' : ''}}"
        data-key="{{item.key}}"
        aria-role="{{item.blank ? '' : 'button'}}"
        aria-label="{{item.label}}"
        aria-hidden="{{item.blank}}"
        bindtap="onPickDay"
      >
        <view wx:if="{{!item.blank}}" class="num {{item.level === 4 ? 'full' : item.level > 0 ? 'part' : ''}}">{{item.day}}</view>
        <view wx:if="{{item.plan}}" class="plan-dot"></view>
      </view>
    </view>
    <view class="legend" aria-hidden="true">
      <view class="num mini full"></view>
      <text>全部完成</text>
      <view class="num mini part"></view>
      <text>完成一部分</text>
      <view class="plan-dot mini"></view>
      <text>有安排</text>
    </view>

    <view class="detail">
      <view class="detail-head">
        <view class="detail-title">{{selectedTitle}}</view>
        <view wx:if="{{allAction}}" class="all-link" aria-role="button" bindtap="onToggleAllDay">{{allAction === 'check' ? '一键补全' : '全部取消'}}</view>
        <view wx:elif="{{dayDetail.length}}" class="detail-hint">{{selectedFuture ? '还没到这天 · 点击可编辑' : '点击可补卡 / 取消'}}</view>
      </view>
      <view wx:if="{{allLater}}" class="detail-note">这天还没开始打卡，可以补记</view>
      <view wx:if="{{selectedKey && !dayDetail.length}}" class="empty">那天还没有习惯</view>
      <view
        wx:for="{{dayDetail}}"
        wx:key="id"
        class="detail-row {{item.active || allLater ? '' : 'inactive'}}"
        aria-role="button"
        aria-label="{{item.name}}，{{selectedFuture ? '计划中，点击编辑' : (item.checked ? '已完成' : '未完成') + (item.active ? '' : '，后来新增') + '，点击切换'}}"
        data-id="{{item.id}}"
        bindtap="onToggleDay"
      >
        <text class="detail-icon">{{item.icon}}</text>
        <text class="detail-name">{{item.name}}</text>
        <text wx:if="{{item.tag}}" class="tag">{{item.tag}}</text>
        <text wx:if="{{!item.active && !allLater}}" class="tag muted">后来新增</text>
        <text wx:if="{{selectedFuture}}" class="detail-edit" aria-hidden="true">›</text>
        <text wx:else class="detail-star {{item.checked ? 'on' : ''}}" aria-hidden="true">{{item.checked ? '★' : '☆'}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="note-head">
      <view class="section-title">随手记</view>
      <view class="seg">
        <view
          class="seg-item {{noteRange === 'month' ? 'active' : ''}}"
          aria-role="button"
          aria-label="{{noteMonthLabel}}{{noteRange === 'month' ? '，已选中' : ''}}"
          data-range="month"
          bindtap="onNoteRange"
        >{{noteMonthLabel}}</view>
        <view
          class="seg-item {{noteRange === 'all' ? 'active' : ''}}"
          aria-role="button"
          aria-label="全部{{noteRange === 'all' ? '，已选中' : ''}}"
          data-range="all"
          bindtap="onNoteRange"
        >全部</view>
      </view>
    </view>
    <view wx:for="{{noteRows}}" wx:key="key">
      <view
        class="note-row"
        aria-role="button"
        aria-label="{{item.name}} {{item.count}} 件{{item.count ? '，点击查看' : ''}}"
        data-key="{{item.key}}"
        bindtap="onToggleNoteCat"
      >
        <text class="note-cat">{{item.icon}} {{item.name}}</text>
        <view class="bar" aria-hidden="true">
          <view class="bar-fill" style="width: {{item.pct}}%"></view>
        </view>
        <text class="note-count {{item.count ? '' : 'zero'}}">{{item.count}}</text>
      </view>
      <view wx:if="{{noteOpenKey === item.key}}" class="note-items">
        <view wx:for="{{item.items}}" wx:for-item="n" wx:key="id" class="note-item">{{n.text}}</view>
        <view wx:if="{{item.more}}" class="note-more">还有 {{item.more}} 件</view>
      </view>
    </view>
    <view class="note-foot">
      {{noteTotal ? '共 ' + noteTotal + ' 件 · 最常做：' + noteTop + ' · 点类别看明细' : (noteRange === 'month' ? '这个月还没有随手记' : '首页点「✎ 记一件事」开始记录')}}
    </view>
  </view>

  <view class="section">
    <view class="section-title">习惯明细</view>
    <view wx:if="{{!habitStats.length}}" class="empty">暂无每天的习惯</view>
    <view wx:for="{{habitStats}}" wx:key="id" class="row">
      <view class="row-icon">{{item.icon}}</view>
      <view class="row-name">{{item.name}}</view>
      <view class="row-nums">
        <view>连续 <text class="hl">{{item.streak}}</text> 天</view>
        <view class="sub">最长 {{item.longest}} · 累计 {{item.total}}</view>
      </view>
    </view>
  </view>

  <view class="game-entry" aria-role="button" aria-label="休息一下，玩一局 2048" bindtap="onOpenGame">
    <text class="game-icon">🎮</text>
    <view class="game-text">
      <view class="game-name">休息一下 · 2048</view>
      <view class="game-desc">打完卡奖励自己一局</view>
    </view>
    <text class="game-arrow" aria-hidden="true">›</text>
  </view>
</view>
