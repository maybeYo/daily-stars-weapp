<view class="page">
  <view class="overview">
    <view class="ov-item">
      <view class="ov-num">{{totalStars}}</view>
      <view class="ov-label">累计星星</view>
    </view>
    <view class="ov-item">
      <view class="ov-num">{{activeDays}}</view>
      <view class="ov-label">打卡天数</view>
    </view>
    <view class="ov-item">
      <view class="ov-num">{{bestStreak}}</view>
      <view class="ov-label">最长连续</view>
    </view>
  </view>

  <view class="section">
    <view class="cal-head">
      <view
        class="cal-nav {{canPrev ? '' : 'disabled'}}"
        aria-role="button"
        aria-label="上个月"
        bindtap="onPrevMonth"
      >‹</view>
      <view class="cal-title">{{monthTitle}}</view>
      <view
        class="cal-nav {{canNext ? '' : 'disabled'}}"
        aria-role="button"
        aria-label="下个月"
        bindtap="onNextMonth"
      >›</view>
    </view>
    <view class="cal-summary">
      本月打卡 <text class="hl">{{monthDays}}</text> 天 · 全勤 <text class="hl">{{monthPerfect}}</text> 天
    </view>
    <view class="week-head">
      <view wx:for="{{weekNames}}" wx:key="*this" class="week-name">{{item}}</view>
    </view>
    <view class="grid">
      <view
        wx:for="{{cells}}"
        wx:key="key"
        class="cell {{item.isToday ? 'today' : ''}} {{item.isFuture ? 'future' : ''}} {{item.key === selectedKey ? 'selected' : ''}}"
        data-key="{{item.key}}"
        aria-role="{{item.blank ? '' : 'button'}}"
        aria-label="{{item.label}}"
        aria-hidden="{{item.blank}}"
        bindtap="onPickDay"
      >
        <view wx:if="{{!item.blank}}" class="num {{item.level === 4 ? 'full' : item.level > 0 ? 'part' : ''}}">{{item.day}}</view>
      </view>
    </view>
    <view class="legend" aria-hidden="true">
      <view class="num mini full"></view>
      <text>全部完成</text>
      <view class="num mini part"></view>
      <text>完成一部分</text>
    </view>

    <view class="detail">
      <view class="detail-title">{{selectedTitle}}</view>
      <view wx:if="{{selectedKey && !dayDetail.length}}" class="empty">那天还没有习惯</view>
      <view
        wx:for="{{dayDetail}}"
        wx:key="id"
        class="detail-row"
        aria-label="{{item.name}}，{{item.checked ? '已完成' : '未完成'}}"
      >
        <text class="detail-icon">{{item.icon}}</text>
        <text class="detail-name">{{item.name}}</text>
        <text class="detail-star {{item.checked ? 'on' : ''}}" aria-hidden="true">{{item.checked ? '★' : '☆'}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">习惯明细</view>
    <view wx:if="{{!habitStats.length}}" class="empty">暂无习惯</view>
    <view wx:for="{{habitStats}}" wx:key="id" class="row">
      <view class="row-icon">{{item.icon}}</view>
      <view class="row-name">{{item.name}}</view>
      <view class="row-nums">
        <view>连续 <text class="hl">{{item.streak}}</text> 天</view>
        <view class="sub">最长 {{item.longest}} · 累计 {{item.total}}</view>
      </view>
    </view>
  </view>
</view>
