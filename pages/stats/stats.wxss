.overview {
  display: flex;
  padding: 32rpx 0;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.ov-item {
  flex: 1;
  text-align: center;
}

.ov-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #E09B00;
}

.ov-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #9A8F7E;
}

.section {
  margin-top: 32rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.week-head,
.grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
}

.week-name {
  text-align: center;
  font-size: 22rpx;
  color: #B3A68F;
  margin-bottom: 12rpx;
}

.cell {
  aspect-ratio: 1;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.cell.today {
  border: 4rpx solid #E09B00;
}

.level-0 { background: #F4EDE0; }
.level-1 { background: #FCE6A4; }
.level-2 { background: #F9D35E; }
.level-3 { background: #F5B301; }
.level-4 { background: #D98E00; }

.legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #B3A68F;
}

.cell.mini {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F4EDE0;
}

.row:last-child {
  border-bottom: none;
}

.row-icon {
  font-size: 40rpx;
  width: 64rpx;
}

.row-name {
  flex: 1;
  font-size: 30rpx;
}

.row-nums {
  text-align: right;
  font-size: 26rpx;
}

.hl {
  color: #E09B00;
  font-weight: 600;
}

.sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #B3A68F;
}

.empty {
  text-align: center;
  color: #B3A68F;
}
