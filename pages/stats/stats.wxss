.overview {
  display: flex;
  padding: 32rpx 0;
  background: var(--surface);
  border-radius: 24rpx;
}

.ov-item {
  flex: 1;
  text-align: center;
}

.ov-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--accent-strong);
}

.ov-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.section {
  margin-top: 32rpx;
  padding: 32rpx;
  background: var(--surface);
  border-radius: 24rpx;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.week-head,
.grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
}

.week-name {
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
  margin-bottom: 12rpx;
}

.cell {
  aspect-ratio: 1;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.cell.today {
  border: 4rpx solid var(--accent-strong);
}

.level-0 { background: var(--heat-0); }
.level-1 { background: var(--heat-1); }
.level-2 { background: var(--heat-2); }
.level-3 { background: var(--heat-3); }
.level-4 { background: var(--heat-4); }

.legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.cell.mini {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.row-icon {
  font-size: 40rpx;
  width: 64rpx;
}

.row-name {
  flex: 1;
  font-size: 30rpx;
}

.row-nums {
  text-align: right;
  font-size: 26rpx;
}

.hl {
  color: var(--accent-strong);
  font-weight: 600;
}

.sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.empty {
  text-align: center;
  color: var(--faint);
}
