.overview {
  display: flex;
  padding: 32rpx 0;
  background: var(--surface);
  border-radius: 24rpx;
}

.ov-item {
  flex: 1;
  text-align: center;
}

.ov-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--accent-strong);
}

.ov-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.section {
  margin-top: 32rpx;
  padding: 32rpx;
  background: var(--surface);
  border-radius: 24rpx;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.week-head,
.grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
}

.week-name {
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
  margin-bottom: 12rpx;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cal-center {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cal-title {
  padding: 8rpx 4rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.cal-title-arrow {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.cal-today {
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: var(--accent-strong);
  background: var(--accent-soft);
  border-radius: 20rpx;
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--accent-strong);
  background: var(--accent-soft);
  border-radius: 50%;
}

.cal-nav.disabled {
  opacity: 0.3;
}

.cal-summary {
  margin: 16rpx 0 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

.cell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1;
  border-radius: 16rpx;
}

.num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--text);
}

/* 完成一部分：金色圆环 */
.num.part {
  border: 4rpx solid var(--accent);
}

/* 全部完成：实心金圆 */
.num.full {
  background: var(--accent);
  color: #FFFFFF;
  font-weight: 600;
}

.cell.today .num {
  color: var(--accent-strong);
  font-weight: 700;
}

.cell.today .num.full {
  color: #FFFFFF;
}

/* 今天：数字下方小横线 */
.cell.today::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 20rpx;
  height: 4rpx;
  margin-left: -10rpx;
  border-radius: 2rpx;
  background: var(--accent-strong);
}

.cell.selected {
  background: var(--accent-soft);
}

.cell.future .num {
  opacity: 0.45;
}

/* 以后的日子有安排：数字下方小金点 */
.plan-dot {
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  border-radius: 50%;
  background: var(--accent);
}

.plan-dot.mini {
  position: static;
  margin-left: 0;
}

.detail-edit {
  font-size: 36rpx;
  color: var(--faint);
}

.legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.legend text {
  margin-right: 16rpx;
}

.legend text:last-child {
  margin-right: 0;
}

.num.mini {
  width: 24rpx;
  height: 24rpx;
}

.num.mini.part {
  border-width: 3rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.row-icon {
  font-size: 40rpx;
  width: 64rpx;
}

.row-name {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  font-size: 30rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-nums {
  text-align: right;
  font-size: 26rpx;
}

.hl {
  color: var(--accent-strong);
  font-weight: 600;
}

.sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.empty {
  text-align: center;
  color: var(--faint);
}

.detail {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.detail-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.detail-title {
  font-size: 26rpx;
  color: var(--muted);
}

.detail-hint {
  font-size: 22rpx;
  color: var(--fainter);
}

.detail-note {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.detail-row:active {
  opacity: 0.6;
}

.detail-row.inactive {
  opacity: 0.5;
}

.detail-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.detail-icon {
  width: 56rpx;
  font-size: 36rpx;
}

.detail-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail-star {
  font-size: 36rpx;
  color: var(--star-off);
}

.detail-star.on {
  color: var(--accent);
}

.tag {
  margin-right: 16rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: var(--accent-strong);
  background: var(--accent-soft);
  border-radius: 8rpx;
}

.tag.muted {
  color: var(--faint);
  background: var(--line);
}


.all-link {
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent-strong);
  background: var(--accent-soft);
  border-radius: 24rpx;
}

.note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.note-head .section-title {
  margin-bottom: 0;
}

.seg {
  display: flex;
  padding: 4rpx;
  background: var(--accent-soft);
  border-radius: 28rpx;
}

.seg-item {
  padding: 6rpx 22rpx;
  font-size: 22rpx;
  color: var(--muted);
  border-radius: 24rpx;
}

.seg-item.active {
  background: var(--surface);
  color: var(--accent-strong);
  font-weight: 600;
}

.note-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.note-row:active {
  opacity: 0.6;
}

.note-cat {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 26rpx;
}

.bar {
  flex: 1;
  height: 16rpx;
  margin: 0 20rpx;
  background: var(--line);
  border-radius: 8rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent-light), var(--accent));
  border-radius: 8rpx;
}

.note-count {
  width: 56rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--accent-strong);
}

.note-count.zero {
  font-weight: 400;
  color: var(--fainter);
}

.note-items {
  margin: 0 0 12rpx 150rpx;
  padding: 12rpx 20rpx;
  background: var(--bg);
  border-radius: 12rpx;
}

.note-item,
.note-more {
  padding: 6rpx 0;
  font-size: 24rpx;
  color: var(--muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.note-more {
  color: var(--faint);
}

.note-foot {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
}
