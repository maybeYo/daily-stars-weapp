<view class="page">
  <view class="header">
    <view class="header-top">
      <view class="date">{{dateText}}</view>
      <view wx:if="{{!sorting}}" class="days">
        <view
          wx:for="{{dayTabs}}"
          wx:key="offset"
          class="day {{item.offset === offset ? 'active' : ''}}"
          data-offset="{{item.offset}}"
          bindtap="onPickDay"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="summary">
      {{offset ? '当天' : '今日'}}已获得 <text class="hl">{{doneCount}}</text> / {{habits.length}} 颗星
    </view>
    <view class="progress">
      <view class="progress-bar" style="width: {{percent}}%"></view>
    </view>
    <view wx:if="{{offset}}" class="makeup">补卡模式：给{{dayTabs[offset].label}}漏打的习惯补上</view>
    <view wx:else class="quote">{{quote}}</view>
  </view>

  <view wx:if="{{!habits.length}}" class="empty">
    {{offset ? '那天还没有创建习惯' : '还没有习惯，先添加一个吧'}}
  </view>

  <view class="list">
    <view
      wx:for="{{habits}}"
      wx:key="id"
      class="card {{item.checked ? 'checked' : ''}}"
      data-id="{{item.id}}"
      bindtap="onToggle"
      bindlongpress="onEdit"
    >
      <view class="icon">{{item.icon}}</view>
      <view class="info">
        <view class="name">{{item.name}}</view>
        <view class="meta">连续 {{item.streak}} 天 · 累计 {{item.total}} 次</view>
      </view>
      <block wx:if="{{sorting}}">
        <view
          class="move {{index === 0 ? 'disabled' : ''}}"
          data-id="{{item.id}}"
          data-dir="-1"
          catchtap="onMove"
        >↑</view>
        <view
          class="move {{index === habits.length - 1 ? 'disabled' : ''}}"
          data-id="{{item.id}}"
          data-dir="1"
          catchtap="onMove"
        >↓</view>
      </block>
      <block wx:else>
        <view class="more" data-id="{{item.id}}" catchtap="onEdit">···</view>
        <view class="star {{item.id === popId ? 'pop' : ''}}">{{item.checked ? '★' : '☆'}}</view>
      </block>
    </view>
  </view>

  <view wx:if="{{habits.length}}" class="tip">
    <text>{{sorting ? '点箭头调整顺序' : '点击卡片打卡 · 点 ··· 编辑'}}</text>
    <text wx:if="{{habits.length > 1}}" class="sort-btn" bindtap="onToggleSort">{{sorting ? '完成' : '排序'}}</text>
  </view>

  <view wx:if="{{sorting}}" class="add btn btn-primary" bindtap="onToggleSort">完成排序</view>
  <view wx:else class="add btn btn-primary" bindtap="onAdd">＋ 新习惯</view>

  <view wx:if="{{stars.length}}" class="burst">
    <text
      wx:for="{{stars}}"
      wx:key="id"
      class="burst-star"
      style="left: {{item.left}}%; font-size: {{item.size}}rpx; animation-delay: {{item.delay}}s"
    >★</text>
  </view>
</view>
