<view class="page">
  <view class="header">
    <view class="header-top">
      <view class="date">{{dateText}}</view>
      <view wx:if="{{!sorting}}" class="days">
        <view
          wx:for="{{dayTabs}}"
          wx:key="offset"
          class="day {{item.offset === offset ? 'active' : ''}}"
          aria-role="button"
          aria-label="{{item.label}}{{item.offset === offset ? '，已选中' : ''}}"
          data-offset="{{item.offset}}"
          bindtap="onPickDay"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="summary-row">
      <view class="summary">
        {{offset ? '当天' : '今日'}}已获得 <text class="hl">{{doneCount}}</text> / {{habits.length}} 颗星
      </view>
      <view
        wx:if="{{habits.length && !sorting}}"
        class="all-btn {{doneCount === habits.length ? 'undo' : ''}}"
        aria-role="button"
        bindtap="onToggleAll"
      >{{doneCount === habits.length ? '全部取消' : (offset ? '一键补全' : '一键完成')}}</view>
    </view>
    <view class="progress">
      <view class="progress-bar" style="width: {{percent}}%"></view>
    </view>
    <view wx:if="{{offset}}" class="makeup">补卡模式：给{{dayTabs[offset].label}}漏打的习惯补上</view>
    <view wx:else class="quote">{{quote}}</view>
  </view>

  <view wx:if="{{!habits.length}}" class="empty">
    {{offset ? '那天没有要打卡的习惯' : '还没有习惯，先添加一个吧'}}
  </view>

  <view class="list">
    <view
      wx:for="{{habits}}"
      wx:key="id"
      class="card {{item.checked ? 'checked' : ''}}"
      aria-role="button"
      aria-label="{{item.name}}，{{item.checked ? '已打卡' : '未打卡'}}，{{item.once ? item.tag : '连续 ' + item.streak + ' 天'}}"
      data-id="{{item.id}}"
      bindtap="onToggle"
      bindlongpress="onEdit"
    >
      <view class="icon">{{item.icon}}</view>
      <view class="info">
        <view class="name">{{item.name}}</view>
        <view wx:if="{{item.once}}" class="meta"><text class="tag">{{item.tag}}</text></view>
        <view wx:else class="meta">连续 {{item.streak}} 天 · 累计 {{item.total}} 次</view>
      </view>
      <block wx:if="{{sorting}}">
        <view
          class="move {{index === 0 ? 'disabled' : ''}}"
          aria-role="button"
          aria-label="上移{{item.name}}"
          data-id="{{item.id}}"
          data-dir="-1"
          catchtap="onMove"
        >↑</view>
        <view
          class="move {{index === habits.length - 1 ? 'disabled' : ''}}"
          aria-role="button"
          aria-label="下移{{item.name}}"
          data-id="{{item.id}}"
          data-dir="1"
          catchtap="onMove"
        >↓</view>
      </block>
      <block wx:else>
        <view class="more" aria-role="button" aria-label="编辑{{item.name}}" data-id="{{item.id}}" catchtap="onEdit">···</view>
        <view class="star {{item.id === popId ? 'pop' : ''}}" aria-hidden="true">{{item.checked ? '★' : '☆'}}</view>
      </block>
    </view>
  </view>

  <view wx:if="{{habits.length}}" class="tip">
    <text>{{sorting ? '点箭头调整顺序' : '点击卡片打卡 · 点 ··· 编辑'}}</text>
    <text wx:if="{{habits.length > 1}}" class="sort-btn" aria-role="button" bindtap="onToggleSort">{{sorting ? '完成' : '排序'}}</text>
  </view>

  <view wx:if="{{upcoming.length && !offset && !sorting}}" class="upcoming">
    <view class="upcoming-title">即将到来</view>
    <view
      wx:for="{{upcoming}}"
      wx:key="id"
      class="upcoming-row"
      aria-role="button"
      aria-label="{{item.dateText}}，{{item.name}}，点击编辑"
      data-id="{{item.id}}"
      bindtap="onEdit"
    >
      <text class="upcoming-date">{{item.dateText}}</text>
      <text class="upcoming-icon">{{item.icon}}</text>
      <text class="upcoming-name">{{item.name}}</text>
      <text wx:if="{{item.tag}}" class="tag">{{item.tag}}</text>
    </view>
  </view>

  <view wx:if="{{sorting}}" class="actions">
    <view class="btn btn-primary action" bindtap="onToggleSort">完成排序</view>
  </view>
  <view wx:else class="actions">
    <view class="btn btn-secondary action" aria-role="button" bindtap="onOpenNote">✎ 记一件事</view>
    <view class="btn btn-primary action" aria-role="button" bindtap="onAdd">＋ 新习惯</view>
  </view>

  <view wx:if="{{noteOpen}}" class="mask" catchtouchmove="noop" bindtap="onCloseNote">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">记一件事</view>
      <view class="sheet-desc">{{noteFuture ? '还没到这天，先安排上，到那天再打卡' : '做完了就记下，直接算一颗星'}}</view>
      <view class="cats">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="cat {{item.key === noteCat ? 'active' : ''}}"
          aria-role="button"
          aria-label="{{item.name}}{{item.key === noteCat ? '，已选中' : ''}}"
          data-key="{{item.key}}"
          bindtap="onPickCat"
        >{{item.icon}} {{item.name}}</view>
      </view>
      <picker mode="date" value="{{noteDate}}" bindchange="onPickNoteDate">
        <view class="sheet-date" aria-role="button" aria-label="日期 {{noteDateText}}，点击修改">
          <text>📅 {{noteDateText}}</text>
          <text class="sheet-date-arrow">修改 ▾</text>
        </view>
      </picker>
      <input
        class="sheet-input"
        value="{{noteText}}"
        placeholder="{{noteHint}}"
        maxlength="20"
        focus="{{noteOpen}}"
        confirm-type="done"
        bindinput="onNoteInput"
        bindconfirm="onSaveNote"
      />
      <view class="btn btn-primary" aria-role="button" bindtap="onSaveNote">{{noteFuture ? '安排' : '记下'}}</view>
    </view>
  </view>

  <view wx:if="{{stars.length}}" class="burst" aria-hidden="true">
    <text
      wx:for="{{stars}}"
      wx:key="id"
      class="burst-star"
      style="left: {{item.left}}%; font-size: {{item.size}}rpx; animation-delay: {{item.delay}}s"
    >★</text>
  </view>
</view>
