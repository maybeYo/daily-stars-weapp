.header {
  padding: 32rpx;
  background: var(--surface);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx var(--shadow);
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date {
  font-size: 26rpx;
  color: var(--muted);
}

.days {
  display: flex;
  padding: 4rpx;
  background: var(--accent-soft);
  border-radius: 28rpx;
}

.day {
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  color: var(--muted);
  border-radius: 24rpx;
}

.day.active {
  background: var(--surface);
  color: var(--accent-strong);
  font-weight: 600;
}

.makeup {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--accent-strong);
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.summary {
  font-size: 36rpx;
  font-weight: 600;
}

.all-btn {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--accent);
  border-radius: 28rpx;
}

.all-btn:active {
  background: var(--accent-strong);
}

.all-btn.undo {
  color: var(--muted);
  background: var(--accent-soft);
}

.hl {
  margin: 0 8rpx;
  color: var(--accent-strong);
  font-size: 48rpx;
}

.progress {
  margin-top: 24rpx;
  height: 16rpx;
  background: var(--accent-soft);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--accent-light), var(--accent));
  border-radius: 8rpx;
  transition: width 0.3s;
}

.quote {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--faint);
}

.empty {
  margin-top: 120rpx;
  text-align: center;
  color: var(--faint);
}

.list {
  margin-top: 32rpx;
}

.card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  background: var(--surface);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.card:active {
  transform: scale(0.98);
}

.card.checked {
  background: var(--checked-bg);
  border-color: var(--checked-border);
}

.icon {
  font-size: 48rpx;
  width: 72rpx;
}

.info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card.checked .name {
  color: var(--checked-text);
}

.meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--faint);
}

.more {
  padding: 16rpx 20rpx;
  margin-right: 8rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: var(--fainter);
}

.star {
  font-size: 56rpx;
  color: var(--star-off);
}

.star.pop {
  animation: pop 0.45s ease-out;
}

@keyframes pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.5) rotate(-12deg); }
  100% { transform: scale(1) rotate(0); }
}

.card.checked .star {
  color: var(--accent);
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--fainter);
}

.tag {
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: var(--accent-strong);
  background: var(--accent-soft);
  border-radius: 8rpx;
}

.upcoming {
  margin-top: 40rpx;
  padding: 24rpx 32rpx;
  background: var(--surface);
  border-radius: 20rpx;
}

.upcoming-title {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.upcoming-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  font-size: 28rpx;
}

.upcoming-date {
  width: 200rpx;
  font-size: 24rpx;
  color: var(--accent-strong);
}

.upcoming-icon {
  width: 56rpx;
}

.upcoming-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sort-btn {
  margin-left: 24rpx;
  padding: 8rpx 0;
  color: var(--accent-strong);
}

.move {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin-left: 12rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--accent-strong);
  background: var(--accent-soft);
  border-radius: 50%;
}

.move.disabled {
  opacity: 0.3;
}

.actions {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 40rpx;
  display: flex;
  gap: 20rpx;
}

.action {
  flex: 1;
}

.action.btn-primary {
  box-shadow: 0 8rpx 24rpx rgba(245, 179, 1, 0.35);
}

.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.4);
}

.sheet {
  width: 100%;
  padding: 40rpx 32rpx 64rpx;
  background: var(--bg);
  border-radius: 32rpx 32rpx 0 0;
  box-sizing: border-box;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
}

.sheet-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--faint);
}

.cats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 32rpx 0 24rpx;
}

.cat {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  background: var(--surface);
  border: 3rpx solid transparent;
  border-radius: 32rpx;
}

.cat.active {
  border-color: var(--accent);
  background: var(--checked-bg);
  color: var(--checked-text);
}

.sheet-date {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  margin-bottom: 20rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  background: var(--surface);
  border-radius: 20rpx;
}

.sheet-date-arrow {
  font-size: 24rpx;
  color: var(--faint);
}

.sheet-input {
  height: 96rpx;
  margin-bottom: 32rpx;
  padding: 0 28rpx;
  background: var(--surface);
  border-radius: 20rpx;
  font-size: 30rpx;
}

.burst {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 10;
}

.burst-star {
  position: absolute;
  top: -80rpx;
  color: var(--accent);
  opacity: 0;
  animation: fall 1.6s ease-in forwards;
}

@keyframes fall {
  0% { transform: translateY(0) rotate(0); opacity: 1; }
  100% { transform: translateY(110vh) rotate(360deg); opacity: 0.2; }
}
